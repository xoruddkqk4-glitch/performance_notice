rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == '0ejtes6iimOXXkXnwmzDs002rmx1';
    }
    function isEditor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/editors/$(request.auth.uid))
        && get(/databases/$(database)/documents/editors/$(request.auth.uid)).data.active == true;
    }
    match /appState/schedules {
      allow read: if true;
      allow write: if isAdmin() || isEditor();
    }
    match /appState/classSettings {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /editors/directory {
      allow read, write: if isAdmin();
    }
    match /editors/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }
  }
}
